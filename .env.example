# Copy to .env and fill in real values. .env is gitignored.

# Database
DB_HOST=localhost
DB_NAME=ichas_admission
DB_USER=root
DB_PASS=

# Application environment: development | production
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Organization defaults — the `organization` table in the DB is the source of truth at runtime.
ORG_CODE=ICHAS
ORG_NAME=Imperial College of Health and Allied Sciences
ORG_EMAIL=info@ichas.ac.tz
